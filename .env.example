GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Merriam-Webster (https://dictionaryapi.com) — 1000 requests/day each, free tier.
# Optional: the app works without them, but they give real etymology, audio and
# better synonyms. Two SEPARATE keys — one per product.
MW_DICTIONARY_KEY=
MW_THESAURUS_KEY=

# Turso (https://turso.tech) — free tier, no inactivity pause.
# Optional: without these the app stays local-only and sync is disabled.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret guarding /api/*. Required once deployed publicly.
APP_SECRET=
VITE_APP_SECRET=
